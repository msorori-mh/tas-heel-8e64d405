# Public configuration: embedded in browser assets at BUILD time.
# Use the same Supabase project for public and server configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server configuration: inject at RUNTIME through your hosting secret manager.
# Never prefix a service-role key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Node server binding (the host can override these).
HOST=127.0.0.1
PORT=3000
