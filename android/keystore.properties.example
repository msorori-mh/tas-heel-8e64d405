# 17B — Android release signing (SIGNING_REQUIRED)
#
# Copy to android/keystore.properties (never commit it) after creating a keystore:
#
#   keytool -genkey -v -keystore tamkeen-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias tamkeen
#
# Then build the Play bundle:
#
#   bunx cap sync android && cd android && ./gradlew bundleRelease
#   -> android/app/build/outputs/bundle/release/app-release.aab

storeFile=/absolute/path/to/tamkeen-release.jks
storePassword=CHANGE_ME
keyAlias=tamkeen
keyPassword=CHANGE_ME
