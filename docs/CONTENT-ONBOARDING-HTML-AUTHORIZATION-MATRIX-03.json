{
  "system": "tas-heel-html-content-onboarding",
  "version": "0.3.0",
  "roles": [
    "admin",
    "content_manager",
    "reviewer",
    "publisher",
    "student"
  ],
  "statuses": [
    "draft",
    "in_review",
    "approved",
    "published",
    "rejected",
    "archived"
  ],
  "resources": [
    "lesson_resources",
    "lesson_resource_versions",
    "lesson_resource_files",
    "lesson_resource_reviews",
    "lesson_resource_events",
    "content_import_batches",
    "content_import_rows",
    "lesson-resource-drafts",
    "lesson-resource-published"
  ],
  "matrix": {
    "admin": {
      "create_import_batch": true,
      "upload_package": true,
      "validate_package": true,
      "submit_for_review": true,
      "approve": true,
      "reject": true,
      "publish": true,
      "unpublish": true,
      "archive": true,
      "fetch_published": true,
      "read_draft_storage": true,
      "write_draft_storage": true,
      "direct_write_published_storage": false
    },
    "content_manager": {
      "create_import_batch": true,
      "upload_package": true,
      "validate_package": true,
      "submit_for_review": true,
      "approve": false,
      "reject": false,
      "publish": false,
      "unpublish": false,
      "archive": false,
      "fetch_published": true,
      "read_draft_storage": true,
      "write_draft_storage": true,
      "direct_write_published_storage": false
    },
    "reviewer": {
      "create_import_batch": false,
      "upload_package": false,
      "validate_package": true,
      "submit_for_review": false,
      "approve": true,
      "reject": true,
      "publish": false,
      "unpublish": false,
      "archive": false,
      "fetch_published": true,
      "read_draft_storage": true,
      "write_draft_storage": false,
      "direct_write_published_storage": false
    },
    "publisher": {
      "create_import_batch": false,
      "upload_package": false,
      "validate_package": true,
      "submit_for_review": false,
      "approve": false,
      "reject": false,
      "publish": true,
      "unpublish": true,
      "archive": true,
      "fetch_published": true,
      "read_draft_storage": true,
      "write_draft_storage": false,
      "direct_write_published_storage": false
    },
    "student": {
      "create_import_batch": false,
      "upload_package": false,
      "validate_package": false,
      "submit_for_review": false,
      "approve": false,
      "reject": false,
      "publish": false,
      "unpublish": false,
      "archive": false,
      "fetch_published": true,
      "read_draft_storage": false,
      "write_draft_storage": false,
      "direct_write_published_storage": false
    }
  },
  "rls_policies": {
    "fail_closed_default": true,
    "table_rules": {
      "lesson_resources": {
        "student_read": "status = 'published' AND can_access_lesson(lesson_id)",
        "staff_write": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')",
        "reviewer_write": "has_role(auth.uid(), 'reviewer') VIA RPC only",
        "publisher_write": "has_role(auth.uid(), 'publisher') VIA RPC only"
      },
      "lesson_resource_versions": {
        "student_read": "status = 'published' AND can_access_lesson(lesson_id)",
        "staff_write": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')"
      },
      "lesson_resource_files": {
        "student_read": "status = 'published' AND can_access_lesson(lesson_id)",
        "staff_write": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')"
      },
      "lesson_resource_reviews": {
        "student_read": false,
        "staff_read": "has_any_staff_role(auth.uid())",
        "reviewer_insert": "has_role(auth.uid(), 'reviewer') OR has_role(auth.uid(), 'admin')"
      },
      "lesson_resource_events": {
        "student_insert": "auth.uid() = user_id AND can_access_lesson(lesson_id)",
        "student_read": "auth.uid() = user_id",
        "staff_read": "has_any_staff_role(auth.uid())"
      },
      "content_import_batches": {
        "student_access": false,
        "staff_access": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')"
      },
      "content_import_rows": {
        "student_access": false,
        "staff_access": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')"
      }
    },
    "storage_rules": {
      "lesson-resource-drafts": {
        "public_read": false,
        "student_read": false,
        "staff_read": "has_any_staff_role(auth.uid()) WITH signed_url",
        "staff_write": "has_role(auth.uid(), 'admin') OR has_role(auth.uid(), 'content_manager')",
        "direct_browser_write": false
      },
      "lesson-resource-published": {
        "public_read": false,
        "student_read": "authenticated AND active_subscription_or_free_access() AND resource_status = 'published'",
        "direct_browser_write": false,
        "publishing_mechanism": "service_role_edge_function_only"
      }
    }
  },
  "concurrency_and_security": {
    "optimistic_concurrency": true,
    "concurrency_key": "active_version",
    "idempotency_key": "content_sha256",
    "audit_trail_required": true,
    "answer_leakage_prohibited": true,
    "pii_in_html_prohibited": true,
    "write_boundary": "Server/RPC/Edge Function service_role strictly enforced"
  }
}
