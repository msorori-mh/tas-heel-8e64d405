{
  "system": "tas-heel-html-content-onboarding",
  "version": "0.5.0",
  "roles": [
    "admin",
    "content_manager",
    "student"
  ],
  "statuses": [
    "draft",
    "in_review",
    "approved",
    "published",
    "rejected",
    "archived"
  ],
  "resources": [
    "lesson_resources",
    "lesson_resource_versions",
    "lesson_resource_files",
    "lesson_resource_reviews",
    "lesson_resource_events",
    "content_import_batches",
    "content_import_rows",
    "idempotency_ledger",
    "lesson-resource-drafts",
    "lesson-resource-published"
  ],
  "matrix": {
    "admin": {
      "create_import_batch": true,
      "finalize_uploaded_package": true,
      "validate_package": true,
      "submit_for_review": true,
      "approve_resource_version": true,
      "reject_resource_version": true,
      "publish_resource_version": true,
      "unpublish_resource_version": true,
      "archive_resource": true,
      "fetch_published_lesson_resources": true,
      "read_draft_storage": true,
      "write_draft_storage": true,
      "direct_write_published_storage": false
    },
    "content_manager": {
      "create_import_batch": true,
      "finalize_uploaded_package": true,
      "validate_package": true,
      "submit_for_review": true,
      "approve_resource_version": false,
      "reject_resource_version": false,
      "publish_resource_version": false,
      "unpublish_resource_version": false,
      "archive_resource": false,
      "fetch_published_lesson_resources": true,
      "read_draft_storage": true,
      "write_draft_storage": true,
      "direct_write_published_storage": false
    },
    "student": {
      "create_import_batch": false,
      "finalize_uploaded_package": false,
      "validate_package": false,
      "submit_for_review": false,
      "approve_resource_version": false,
      "reject_resource_version": false,
      "publish_resource_version": false,
      "unpublish_resource_version": false,
      "archive_resource": false,
      "fetch_published_lesson_resources": true,
      "read_draft_storage": false,
      "write_draft_storage": false,
      "direct_write_published_storage": false
    }
  },
  "rls_policies": {
    "fail_closed_default": true,
    "table_rules": {
      "lesson_resources": {
        "student_read": "status = 'published' AND published_version_id IS NOT NULL AND public.can_access_lesson(lesson_id)",
        "staff_write": "(public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')) VIA RPC",
        "admin_approve_publish": "public.has_role(auth.uid(), 'admin') VIA RPC only"
      },
      "lesson_resource_versions": {
        "student_read": "id = (SELECT published_version_id FROM public.lesson_resources WHERE id = lesson_resource_versions.resource_id AND status = 'published') AND public.can_access_lesson(lesson_id)",
        "staff_write": "(public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')) VIA RPC"
      },
      "lesson_resource_files": {
        "student_read": "version_id = (SELECT published_version_id FROM public.lesson_resources WHERE id = (SELECT resource_id FROM public.lesson_resource_versions WHERE id = lesson_resource_files.version_id) AND status = 'published') AND public.can_access_lesson(lesson_id)",
        "staff_write": "(public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')) VIA RPC"
      },
      "lesson_resource_reviews": {
        "student_read": false,
        "staff_read": "public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')",
        "admin_insert": "public.has_role(auth.uid(), 'admin') VIA RPC"
      },
      "lesson_resource_events": {
        "student_insert": "auth.uid() = user_id AND public.can_access_lesson(lesson_id)",
        "student_read": "auth.uid() = user_id",
        "staff_read": "public.has_role(auth.uid(), 'admin')"
      },
      "content_import_batches": {
        "student_access": false,
        "staff_access": "public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')"
      },
      "content_import_rows": {
        "student_access": false,
        "staff_access": "public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')"
      },
      "idempotency_ledger": {
        "student_access": false,
        "staff_access": "public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')"
      }
    },
    "storage_rules": {
      "lesson-resource-drafts": {
        "public_read": false,
        "student_read": false,
        "staff_read": "(public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')) WITH scoped_signed_url",
        "staff_write": "(public.has_role(auth.uid(), 'admin') OR public.has_role(auth.uid(), 'content_manager')) WITH staging_signed_upload_url",
        "direct_browser_write": false
      },
      "lesson-resource-published": {
        "public_read": false,
        "student_read": "authenticated AND active_subscription_and_lesson_access() WITH server_signed_short_lived_url",
        "direct_browser_write": false,
        "publishing_mechanism": "service_role_rpc_edge_function_only"
      }
    }
  },
  "concurrency_and_security": {
    "optimistic_concurrency": true,
    "concurrency_key": "lock_version",
    "idempotency_key": "actor_id_operation_idempotency_key_unique",
    "audit_trail_required": true,
    "answer_leakage_prohibited": true,
    "no_client_hashed_answer_keys": true,
    "pii_in_html_prohibited": true,
    "write_boundary": "Server/RPC/Edge Function service_role strictly enforced"
  }
}
